body {
    background-color: white;
    color: black;
    font-family: Arial, Helvetica, sans-serif;
    margin: 0;
    padding: 25px;
    line-height: 1.5;
}

body::before {
    content: "MY MULTIMEDIA PAGE";
    font-size: 30px;
    font-weight: bold;
    letter-spacing: 2px;
    text-align: center;
    border-bottom: 4px solid black;
    padding-bottom: 15px;
    margin-bottom: 30px;
}

.content {
    background-color: #eeeeee;
    border: 2px solid black;
    border-radius: 10px;
    padding: 20px;
    margin: 20px auto;
    max-width: 900px;
    box-shadow: 5px 5px 0px #888888;
}
.content h3 {
    background-color: #555555;
    color: white;
    font-size: 20px;
    margin: -20px -20px 15px -20px;
    padding: 12px 15px;
    border-bottom: 2px solid black;
    border-radius: 8px 8px 0 0;
}

.content p {
    color: black;
    font-size: 15px;
    font-weight: bold;
    margin-bottom: 15px;
}
.content img {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border: 3px solid black;
    border-radius: 8px;
    margin: 5px;
    box-shadow: 3px 3px 0px #777777;
}

.content audio {
    width: 100%;
    max-width: 600px;
}

.content video {
    width: 100%;
    max-width: 650px;
    height: auto;
    border: 3px solid black;
    border-radius: 8px;
    background-color: #333333;
}
.content:hover {
    background-color: #dddddd;
    box-shadow: 7px 7px 0px #666666;
}
media screen and (max-width: 600px) {

    body {
        padding: 12px;
    }

    body::before {
        font-size: 22px;
    }

    .content {
        padding: 15px;
        margin: 15px auto;
    }

    .content h3 {
        margin: -15px -15px 12px -15px;
        font-size: 18px;
    }

    .content img {
        width: 140px;
        height: 140px;
    }

    .content audio {
        width: 100%;
    }

    .content video {
        width: 100%;
    }
}